{
  "name": "triple-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "bun --filter triple-agent-web dev",
    "build": "bun --filter triple-agent-web build",
    "start": "bun --filter triple-agent-web start",
    "lint": "bun --filter triple-agent-web lint",
    "typecheck": "bun --filter triple-agent-web typecheck",
    "test": "bun --filter triple-agent-web test",
    "server:dev": "go run ./server/cmd/tripleagent",
    "server:test": "go test ./server/...",
    "up": "docker compose up --build",
    "down": "docker compose down"
  }
}
